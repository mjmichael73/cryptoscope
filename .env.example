# cryptoscope local environment template.
# Copy this file to .env and adjust values for your machine.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=info

# Production DB credentials must be rendered from Vault or a cloud secret
# manager to read-only files. Set CRYPTOSCOPE_ENV=production and configure
# POSTGRES_DSN_FILE, MONGO_URI_FILE, CLICKHOUSE_USER_FILE, and
# CLICKHOUSE_PASSWORD_FILE as needed. Redis uses REDIS_PASSWORD_FILE plus
# REDIS_TLS_ENABLED=true in production.
# See docs/production.md for the service-to-secret mapping.

# ---------------------------------------------------------------------------
# Api Gateway
# ---------------------------------------------------------------------------
# Set DEV_MODE=true only for local development (bypasses JWT auth).
# APP_ENV=production rejects DEV_MODE=true. Leave DEV_MODE=false to use Keycloak.
DEV_MODE=true
API_GATEWAY_HTTP_PORT=8080

# Upstream service addresses (used by the gateway to route requests)
QUERY_SERVICE_GRPC_ADDR=query-service:9001
COMMAND_SERVICE_HTTP_ADDR=http://command-service:8002
ALERT_SERVICE_HTTP_ADDR=http://alert-service:8003

# Rate limiting (token bucket per tenant)
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=40

# ---------------------------------------------------------------------------
# Keycloak (authentication and tenant claims)
# Required when DEV_MODE=false. The gateway exits if settings are invalid or
# the initial JWKS fetch fails. Access tokens must include a tenant_id claim.
# ---------------------------------------------------------------------------
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/cryptoscope/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://keycloak:8080/realms/cryptoscope
KEYCLOAK_AUDIENCE=cryptoscope-api

# ---------------------------------------------------------------------------
# PostgreSQL (tenants, watchlists, alert rules, triggers)
# Used by: command-service, alert-service
#
# This is the SHARED instance from ~/projects/shared-services
# (external network shared-services-network, database: cryptoscope).
# The credential is the one registered for this project in
# ~/projects/shared-services/projects.yml — rotate it there, then here.
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgres://cryptoscope:HCtUz4EMXyavcKRC@postgres:5432/cryptoscope?sslmode=disable

# ---------------------------------------------------------------------------
# ClickHouse (OHLC candles and time-series analytics)
# Used by: stream-processor (native), query-service (HTTP)
# ---------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=cryptoscope
CLICKHOUSE_USER=cryptoscope
CLICKHOUSE_PASSWORD=cryptoscope

# Local-only credentials used by docker-compose.yml. Change these values for
# any shared development environment; production secrets are mounted as files.
MONGO_ROOT_USERNAME=cryptoscope
MONGO_ROOT_PASSWORD=cryptoscope
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cryptoscope

# ---------------------------------------------------------------------------
# MongoDB (raw ingested payloads and audit archive)
# Used by: stream-processor
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://cryptoscope:cryptoscope@mongo:27017/?authSource=admin
MONGO_DB=cryptoscope

# ---------------------------------------------------------------------------
# Redis (rate limiting and ingestion idempotency)
# Used by: api-gateway, ingest-service
# ---------------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_PASSWORD_FILE=
# Production Redis requires a mounted REDIS_PASSWORD_FILE and TLS.
REDIS_TLS_ENABLED=false
REDIS_DB=0

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_TICKS=market.ticks.raw
KAFKA_TOPIC_EVENTS=domain.events
KAFKA_TOPIC_ALERTS=alerts.triggers
KAFKA_CONSUMER_GROUP=cryptoscope

# ---------------------------------------------------------------------------
# Ingest service
# ---------------------------------------------------------------------------
BINANCE_BASE_URL=https://api.binance.com
COINBASE_BASE_URL=https://api.exchange.coinbase.com
INGEST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INGEST_POLL_INTERVAL_SECONDS=15

# ---------------------------------------------------------------------------
# Stream processor
# ---------------------------------------------------------------------------
TENANT_ID=demo-tenant
PROCESSOR_INTERVALS=1m,5m,1h,1d

# ---------------------------------------------------------------------------
# Query service
# ---------------------------------------------------------------------------
QUERY_SERVICE_HTTP_PORT=8001
QUERY_SERVICE_GRPC_PORT=9001
QUERY_CACHE_TTL_SECONDS=15

# ---------------------------------------------------------------------------
# Command service
# ---------------------------------------------------------------------------
COMMAND_SERVICE_HTTP_PORT=8002

# ---------------------------------------------------------------------------
# Alert service
# ---------------------------------------------------------------------------
ALERT_SERVICE_HTTP_PORT=8003

# Notification channels (all optional — empty means notifications disabled)
# Uncomment and configure the channels you want to enable.
#
# Email (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
# SMTP_TO=ops@example.com  # comma-separated for multiple recipients
#
# Slack incoming webhook
# SLACK_WEBHOOK_URL=
#
# Generic webhook (JSON POST)
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_AUTH=  # e.g. "Bearer <token>"

# ---------------------------------------------------------------------------
# Observability (OpenTelemetry + Prometheus)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=cryptoscope
PROMETHEUS_METRICS_PORT=9100
